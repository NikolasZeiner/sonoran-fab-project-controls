          <DataField>metric_1</DataField>
        </Field>
        <Field Name="metric_2">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>metric_2</DataField>
        </Field>
        <Field Name="amount_1">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>amount_1</DataField>
        </Field>
        <Field Name="amount_2">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>amount_2</DataField>
        </Field>
        <Field Name="date_1">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>date_1</DataField>
        </Field>
        <Field Name="date_2">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>date_2</DataField>
        </Field>
        <Field Name="days_value">
          <rd:TypeName>System.Int32</rd:TypeName>
