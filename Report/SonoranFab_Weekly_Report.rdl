  <DataSets>
    <DataSet Name="DsAreas">
      <Query>
        <DataSourceName>SonoranFab</DataSourceName>
        <CommandText>SELECT area_id, area_name FROM areas ORDER BY area_id;</CommandText>
      </Query>
      <Fields>
        <Field Name="area_id">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>area_id</DataField>
        </Field>
        <Field Name="area_name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>area_name</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DsWeeks">
      <Query>
        <DataSourceName>SonoranFab</DataSourceName>
        <CommandText>SELECT DISTINCT week_ending FROM weekly_cost ORDER BY week_ending DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="week_ending">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>week_ending</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DsAreaSummary">
      <Query>
        <DataSourceName>SonoranFab</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@WeekEnding">
            <Value>=Parameters!WeekEnding.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT area_id, area_name, area_manager, bac, pv, ev, ac, cpi, spi, eac,
       eac - bac AS projected_overrun
FROM vw_area_performance_weekly
WHERE week_ending = @WeekEnding AND area_id IN (@Area)
ORDER BY area_id;</CommandText>
      </Query>
      <Fields>
        <Field Name="area_id">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>area_id</DataField>
        </Field>
        <Field Name="area_name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>area_name</DataField>
        </Field>
        <Field Name="area_manager">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>area_manager</DataField>
        </Field>
        <Field Name="bac">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>bac</DataField>
        </Field>
        <Field Name="pv">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>pv</DataField>
        </Field>
        <Field Name="ev">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>ev</DataField>
        </Field>
        <Field Name="ac">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>ac</DataField>
        </Field>
        <Field Name="cpi">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>cpi</DataField>
        </Field>
        <Field Name="spi">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>spi</DataField>
        </Field>
        <Field Name="eac">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>eac</DataField>
        </Field>
        <Field Name="projected_overrun">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>projected_overrun</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DsSuppliers">
      <Query>
        <DataSourceName>SonoranFab</DataSourceName>
        <CommandText>SELECT supplier_name, delivered_pos, late_pos, on_time_rate, open_spend_at_risk
FROM vw_supplier_scorecard
ORDER BY on_time_rate;</CommandText>
      </Query>
      <Fields>
        <Field Name="supplier_name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>supplier_name</DataField>
        </Field>
        <Field Name="delivered_pos">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>delivered_pos</DataField>
        </Field>
        <Field Name="late_pos">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>late_pos</DataField>
        </Field>
        <Field Name="on_time_rate">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>on_time_rate</DataField>
        </Field>
        <Field Name="open_spend_at_risk">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>open_spend_at_risk</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DsAreaDetail">
      <Query>
        <DataSourceName>SonoranFab</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@WeekEnding">
            <Value>=Parameters!WeekEnding.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT *
FROM vw_area_report_detail
WHERE area_id IN (@Area)
  AND (section &lt;&gt; 'Cost' OR week_ending = @WeekEnding)
ORDER BY area_id, section, group_name;</CommandText>
      </Query>
      <Fields>
        <Field Name="section">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>section</DataField>
        </Field>
        <Field Name="week_ending">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>week_ending</DataField>
        </Field>
        <Field Name="area_id">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>area_id</DataField>
        </Field>
        <Field Name="area_name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>area_name</DataField>
        </Field>
        <Field Name="area_manager">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>area_manager</DataField>
        </Field>
        <Field Name="group_name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>group_name</DataField>
        </Field>
        <Field Name="item_id">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>item_id</DataField>
        </Field>
        <Field Name="item_name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>item_name</DataField>
        </Field>
        <Field Name="metric_1">
